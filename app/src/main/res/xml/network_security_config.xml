<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Keep the default HTTPS-only policy; allow cleartext only for a
         loopback feed used during local payload development. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- LAN feed host (tools/feed_server.py); update if the host IP changes. -->
        <domain includeSubdomains="false">192.168.3.247</domain>
    </domain-config>
</network-security-config>
